# Cache + security headers for Cloudflare Pages/Netlify.
# GitHub Pages ignores this file; configure via Cloudflare Transform Rules if on GH Pages origin.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; frame-src https://reservation-widget.tagme.com.br; connect-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com; img-src 'self' data: https:; object-src 'none'; base-uri 'self'; form-action 'self'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Images and icons: long cache, immutable (content-addressed by filename)
/assets/*.webp
  Cache-Control: public, max-age=31536000, immutable
/assets/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/assets/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/assets/*.png
  Cache-Control: public, max-age=31536000, immutable
/assets/*.svg
  Cache-Control: public, max-age=31536000, immutable

# Fonts: long cache (never change filenames)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# CSS and JS: 1 week, must-revalidate (files change with updates)
/assets/*.css
  Cache-Control: public, max-age=604800, must-revalidate
/assets/css/*
  Cache-Control: public, max-age=604800, must-revalidate
/assets/*.js
  Cache-Control: public, max-age=604800, must-revalidate

# Service Worker: always revalidate
/sw.js
  Cache-Control: no-cache

# HTML: 5 min cache, always revalidate
/*.html
  Cache-Control: public, max-age=300, must-revalidate

# Sitemap: 1-day cache, revalidate (refresh on each deploy)
/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: application/xml; charset=UTF-8
